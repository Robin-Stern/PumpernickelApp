# Normalize line endings on commit. Source files always stored as LF.
* text=auto eol=lf

# Explicit text files
*.kt          text eol=lf
*.kts         text eol=lf
*.swift       text eol=lf
*.java        text eol=lf
*.md          text eol=lf
*.json        text eol=lf
*.xml         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.gradle      text eol=lf
*.properties  text eol=lf
*.plist       text eol=lf
*.pbxproj     text eol=lf
*.sh          text eol=lf

# Binary files
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.pdf         binary
*.zip         binary
*.jar         binary
*.aar         binary
*.so          binary
*.dylib       binary
*.mp3         binary
*.mp4         binary
*.ttf         binary
*.otf         binary
*.woff        binary
*.woff2       binary
